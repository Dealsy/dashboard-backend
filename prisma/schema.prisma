// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    seed     = "ts-node prisma/seed.ts"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Add your models here
model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    firstName String
    lastName  String
    password  String
    role      String   @default("USER")
    address   String?
    phone     String?
    title     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Motorbike {
    id          Int           @id @default(autoincrement())
    brand       String
    model       String
    year        Int
    category    String // e.g., "Sport", "Cruiser", "Adventure"
    engineSize  Float
    price       Float
    color       String
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    sales       Sale[]
    maintenance Maintenance[]
    inventory   Inventory?
}

model Sale {
    id           Int       @id @default(autoincrement())
    motorbikeId  Int
    motorbike    Motorbike @relation(fields: [motorbikeId], references: [id])
    salePrice    Float
    saleDate     DateTime  @default(now())
    customerName String
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
}

model Maintenance {
    id          Int       @id @default(autoincrement())
    motorbikeId Int
    motorbike   Motorbike @relation(fields: [motorbikeId], references: [id])
    serviceType String // e.g., "Oil Change", "Tire Replacement"
    cost        Float
    serviceDate DateTime  @default(now())
    notes       String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model Inventory {
    id          Int       @id @default(autoincrement())
    motorbikeId Int       @unique
    motorbike   Motorbike @relation(fields: [motorbikeId], references: [id])
    quantity    Int
    location    String
    lastUpdated DateTime  @updatedAt
}
